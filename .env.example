# Plantilla publica. Copiar a .secrets/credentials.env para uso local.
# Valores literales: NOMBRE=valor. No usar comandos ni comentarios al final.
# Dejar vacias las variables que no se utilicen.

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
PROJECT_DOMAIN=

# AWS: preferir un perfil autenticado con AWS CLI.
AWS_PROFILE=
AWS_REGION=
AWS_ACCOUNT_ID=

# AWS: alternativa opcional con credenciales temporales.
# No mezclar este metodo con AWS_PROFILE.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Google Cloud: usar la sesion existente de gcloud.
GOOGLE_CLOUD_PROJECT=project-dba46330-c40e-432b-9ad
GOOGLE_CLOUD_REGION=

# Opcional: ruta absoluta a una clave JSON guardada dentro de .secrets.
# Dejar vacio si se usa autenticacion de usuario o credenciales predeterminadas.
GOOGLE_APPLICATION_CREDENTIALS=

# MariaDB: completar cuando se despliegue la base de datos.
MARIADB_DATABASE=
MARIADB_APP_USER=
MARIADB_APP_PASSWORD=
MARIADB_REPLICATION_USER=
MARIADB_REPLICATION_PASSWORD=

# Futuros proveedores: agregar nuevas variables aqui y en el archivo local.
