limit_req_zone $binary_remote_addr zone=polaris_login:10m rate=5r/m;
log_format polaris_safe '$remote_addr $request_method $uri $status $request_time';
access_log /var/log/nginx/access.log polaris_safe;
upstream polaris_app {
  zone polaris_app 64k;
  resolver 127.0.0.11 valid=10s ipv6=off;
  server app:3000 resolve;
  keepalive 16;
}
server {
  listen 80;
  server_name ${PUBLIC_DOMAIN};
  server_tokens off;
  location /.well-known/acme-challenge/ {
    root /var/www/acme;
    try_files $uri @acme_peer;
  }
  # A challenge can be issued by either cloud while DNS selects the other site.
  # The peer path never forwards again, avoiding recursive proxy requests.
  location /_polaris-acme/ {
    allow ${ACME_PEER_IP};
    deny all;
    alias /var/www/acme/.well-known/acme-challenge/;
  }
  location @acme_peer {
    rewrite ^/\.well-known/acme-challenge/(.+)$ /_polaris-acme/$1 break;
    proxy_pass http://${ACME_PEER_IP};
    proxy_set_header Host $host;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
  }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl;
  server_name ${PUBLIC_DOMAIN};
  server_tokens off;
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  add_header Strict-Transport-Security "max-age=31536000" always;
  client_max_body_size 1m;
  # The site has one local application upstream; DNS selects the cloud.
  proxy_next_upstream off;
  location = /api/v1/session {
    limit_req zone=polaris_login burst=10 nodelay;
    limit_req_status 429;
    proxy_pass http://polaris_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
  }
  location / {
    proxy_pass http://polaris_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
  }
}
