POLARIS_IMAGE=ghcr.io/TU_ORGANIZACION/polaris-ues:VERSION
SITE_NAME=aws
APP_WRITES_ENABLED=false
PUBLIC_DOMAIN=aws.lab.tudominio.com
APP_ALLOWED_ORIGINS=https://app.lab.tudominio.com,https://aws.lab.tudominio.com,https://gcp.lab.tudominio.com
MARIADB_HOST=ENDPOINT_PRIVADO_RDS
MARIADB_SSL_SERVER_NAME=ENDPOINT_PRIVADO_RDS
MARIADB_PORT=3306
MARIADB_DATABASE=polaris_ues
MARIADB_APP_USER=polaris_app
MARIADB_APP_PASSWORD=
AUTH_SECRET=
DATABASE_CA_DIR=/opt/polaris-ues/database-ca
TLS_CERT_DIR=/opt/polaris-ues/tls
ACME_WEBROOT_DIR=/opt/polaris-ues/acme
