{
  "openapi": "3.1.0",
  "info": {
    "title": "Polaris UES API",
    "version": "1.0.0",
    "description": "API para personal interno. Las mutaciones requieren Origin autorizado. Cantidades en gramos."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Desarrollo local"
    }
  ],
  "paths": {
    "/api/v1/session": {
      "get": {
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Sesión requerida"
          },
          "403": {
            "description": "Acceso no permitido"
          },
          "503": {
            "description": "Servicio no disponible"
          }
        },
        "summary": "Consultar sesión"
      },
      "post": {
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas"
          },
          "403": {
            "description": "Origen no permitido"
          },
          "429": {
            "description": "Límite de intentos"
          }
        }
      },
      "delete": {
        "summary": "Cerrar sesión del navegador",
        "responses": {
          "200": {
            "description": "Respuesta JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Origen no permitido"
          }
        }
      }
    },
